# ============================================================
# AI Data Analytics Copilot — Environment Variables Example
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to Git.
# ============================================================

# ── Node.js API (apps/api) ──────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000

# ── MongoDB ─────────────────────────────────────────────────
# For Phase 1 testing: use MongoDB Atlas free tier or local MongoDB
# Local: mongodb://localhost:27017/ai_da_copilot
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/ai_da_copilot
MONGODB_URI=mongodb://localhost:27017/ai_da_copilot

# ── Python FastAPI (services/ai) ────────────────────────────
AI_PORT=8000
ENVIRONMENT=development
NODE_API_URL=http://localhost:3001

# ── Ollama (Phase 6) ────────────────────────────────────────
# Ollama runs locally. Install from https://ollama.com
# Then run: ollama pull llama3.2
# And: ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── ChromaDB (Phase 6) ──────────────────────────────────────
# Local file path for ChromaDB vector storage
CHROMA_DB_PATH=./chroma_db

# ── File Upload (Phase 2) ───────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads
