 ============================================================
# AI Data Analytics Copilot — .gitignore
# ============================================================

# -- Environment Variables (NEVER commit secrets)
.env
.env.local
.env.development
.env.production
.env.test

# -- Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.pnpm-store/

# -- React / Vite build output
apps/web/dist/
apps/web/.vite/

# -- Python
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.egg-info/
dist/
build/

# -- Python virtual environment
services/ai/venv/
services/ai/.venv/
venv/
.venv/
env/

# -- ChromaDB local storage
services/ai/chroma_db/
services/ai/.chroma/

# -- Uploaded datasets (user data, not source code)
services/ai/uploads/
apps/api/uploads/

# -- Logs
*.log
logs/

# -- OS generated files
.DS_Store
Thumbs.db
desktop.ini

# -- IDE / Editor
.idea/
*.swp
*~

# -- Testing
coverage/
.pytest_cache/
htmlcov/

# -- MongoDB local data
data/db/

# -- Temporary files
*.tmp
tmp/
temp/
